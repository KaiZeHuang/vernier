<!--
  Android 11 and earlier read this file. Android 12 and later use data_extraction_rules.xml
  instead, but the manifest still references this one so older releases behave the same way.

  android:allowBackup="false" already turns backup off; these rules are the second layer.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
