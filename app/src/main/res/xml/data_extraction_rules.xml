<!--
  Android 12 and later read this file for both cloud backup and device-to-device transfer.

  The manifest sets android:allowBackup="false", which already turns both off. These rules are the
  second layer: every domain the app can write to is excluded, so turning allowBackup back on
  cannot start exporting scan results, detector evidence or settings off the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
