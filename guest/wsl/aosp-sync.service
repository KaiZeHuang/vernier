[Unit]
Description=AOSP supervised sync (repo sync with crash retry)
Documentation=https://source.android.com/docs/setup/download
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/sp/aosp

# systemd does not read ~/.profile or ~/.profile.d, so repo (~/bin) and
# the zero-sudo deps (~/opt/deps) must be added explicitly.
Environment=HOME=%h
Environment=PATH=%h/bin:%h/opt/deps/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Where the Vernier checkout lives inside WSL. Override with `systemctl edit aosp-sync.service`
# or by dropping a drop-in into ~/.config/systemd/user/.
Environment=VERNIER_REPO_ROOT=%h/vernier

ExecStart=/bin/bash ${VERNIER_REPO_ROOT}/guest/wsl/sync-aosp.sh
Restart=always
RestartSec=15

# repo sync is heavy IO + network; keep it away from the OOM killer.
OOMScoreAdjust=-200

# The retry loop lives inside sync-aosp.sh, so Restart=always just resets it.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
